# DRX-Operator 环境变量示例
# 复制为 .env 后可自动加载或 source 到 shell（.env 已被 .gitignore 忽略）

# --- LLM Provider 配置（优先级：环境变量 > configs/default_config.json）---
DRX_LLM_API_KEY=
DRX_LLM_MODEL=
DRX_LLM_BASE_URL=
# DRX_LLM_PROVIDER=openai_compatible

# --- 对应 Provider 独立密钥 ---
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 可选 ---
PYTHONUNBUFFERED=1
