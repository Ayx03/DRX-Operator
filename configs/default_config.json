{
  "llm": {
    "enabled": true,
    "provider": "openai_compatible",
    "model": "deepseek-v4-pro",
    "api_key": "",
    "base_url": "https://api.deepseek.com",
    "temperature": 0.7,
    "max_tokens": 4096,
    "context_window": 1000000,
    "verify_ssl": true,
    "proxy": null,
    "retry": {
      "max_retries": 3,
      "base_delay": 1.0,
      "max_delay": 30.0
    },
    "fallback": [],
    "features": {
      "vulnerability_analysis": true,
      "recommendations": true,
      "threat_intel": true,
      "natural_query": true
    }
  },
  "collaboration": {
    "batch_size": 8,
    "max_intents": 512,
    "scheduler": {
      "max_concurrent": 16,
      "max_concurrent_per_target": 4,
      "global_qps": 8
    },
    "voting": {
      "enabled": true,
      "timeout_s": 180
    },
    "roles": {},
    "memory": {
      "enabled": true,
      "path": ".drx/memory.json",
      "max_entries": 1000,
      "top_k": 5,
      "prompt_chars": 3000,
      "revision": ""
    }
  },
  "mcp": {
    "servers": {
      "_example": {
        "enabled": false,
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
      }
    }
  }
}